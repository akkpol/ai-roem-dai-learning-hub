# Neon pooled runtime connection string. Vercel's Neon integration sets this in each environment.
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Owner/direct connection used only by migration jobs. Never expose it to the app runtime.
DATABASE_URL_UNPOOLED=postgresql://owner:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth v0.2 values are added after Auth is enabled in the Neon console.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Local-only read model. Production ignores this unless providers are fully configured.
DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
BOOTSTRAP_ADMIN_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Learning Studio rollout flags. Production defaults to false when omitted.
FEATURE_LEARNING_WORKSPACES=true
FEATURE_LEARNING_AUTHORING=true
FEATURE_LEARNING_PAYMENTS=true
FEATURE_LEARNING_COMMUNITY=true

# Stripe-hosted Checkout. Enable PromptPay and cards in the Stripe Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Gmail account dedicated to the system. Use a 2FA App Password, never the account password.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
EMAIL_FROM="AI เริ่มได้ <no-reply@example.com>"

# Vercel Cron bearer secret and private Blob credentials/integration values.
CRON_SECRET=
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
