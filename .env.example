NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Pooled application URL from an approved isolated Neon branch. Remote URLs must
# include sslmode=require, sslmode=verify-ca, or sslmode=verify-full.
DATABASE_URL=
# Direct migration URL from the same approved Neon branch with an enforcing
# sslmode. Never expose either connection URL to runtime logs or build output.
MIGRATION_DATABASE_URL=
# Non-secret identity supplied by the approved Neon operator before a reset.
NEON_PROJECT_ID=
NEON_BRANCH_ID=
NEON_BRANCH_NAME=
NEON_BRANCH_IS_DEFAULT=false
NEON_ENDPOINT_ID=
NEON_ENDPOINT_HOSTNAME=
NEON_DATABASE_NAME=
# Exact database name plus the pipe-delimited identity acknowledgement required
# by the integration reset guard. These values authorize no provider mutation.
REMOTE_TEST_DATABASE_RESET_ACK=
REMOTE_TEST_NEON_IDENTITY_ACK=
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=10000
