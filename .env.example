NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Pooled application URL from an approved isolated Neon branch. Remote URLs must
# include sslmode=require, sslmode=verify-ca, or sslmode=verify-full.
DATABASE_URL=
# Direct migration URL from the same approved Neon branch with an enforcing
# sslmode. Never expose either connection URL to runtime logs or build output.
MIGRATION_DATABASE_URL=
# Dedicated credential that is a member of the NOLOGIN
# learning_hub_identity_maintenance role. Used only by identity:retention.
IDENTITY_MAINTENANCE_DATABASE_URL=
# Required only with `npm run identity:retention -- --execute`. Production is
# intentionally rejected by this SESSION-004 operator command.
IDENTITY_RETENTION_ENVIRONMENT=preview
# Exact acknowledgement: `<project-id>:<branch-id>:<hostname>/<database>` for
# remote Neon, or `local:<hostname>/<database>` for a local target.
IDENTITY_RETENTION_TARGET_ACK=
# Secret used only for read-only Neon control-plane identity checks before any
# remote migration or reset connection. Never expose it to application runtime.
NEON_API_KEY=
# Requested non-secret identity. It authorizes nothing until the control-plane
# lookup independently proves the exact branch, endpoint, and database.
NEON_PROJECT_ID=
NEON_BRANCH_ID=
NEON_BRANCH_NAME=
NEON_BRANCH_IS_DEFAULT=false
NEON_ENDPOINT_ID=
NEON_ENDPOINT_HOSTNAME=
NEON_DATABASE_NAME=
# Exact database name plus the pipe-delimited identity acknowledgement required
# by the integration reset guard. These values cannot replace provider truth.
REMOTE_TEST_DATABASE_RESET_ACK=
REMOTE_TEST_NEON_IDENTITY_ACK=
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=10000
